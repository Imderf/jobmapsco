# Copia este archivo como .env y llena los valores. El .env nunca va a git.

# Obligatoria para actualizar ofertas: JSearch en RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=

# Opcionales: aviso por correo cuando el cupo mensual de JSearch se está acabando (https://resend.com)
RESEND_API_KEY=
AVISO_CORREO=
# Remitente con tu dominio verificado en Resend; vacío usa onboarding@resend.dev
AVISO_REMITENTE=
