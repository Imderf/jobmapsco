# Apache / LiteSpeed: la web no sirve archivos ocultos (.env, .git), scripts, SQL ni notas internas
RedirectMatch 404 /\.(?!well-known/)
RedirectMatch 404 /(scripts|db)/
RedirectMatch 404 \.md$
RedirectMatch 404 /\.env\.example$

# El HTML siempre se revalida: sin esto el navegador puede mostrar una versión vieja después de publicar
<IfModule mod_headers.c>
  <FilesMatch "\.html?$|^$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Librerías con la versión en la ruta: no cambian nunca, el navegador las guarda un año
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/vendor/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
